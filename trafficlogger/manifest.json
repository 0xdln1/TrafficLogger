{
    "manifest_version": 2,
    "name": "Real-Time HAR Logger",
    "version": "1.1",
    "permissions": [
      "storage",
      "webRequest",
      "webRequestBlocking",
      "webNavigation",
      "debugger",
      "activeTab",
      "<all_urls>"
    ],
    "background": {
      "scripts": ["background.js"],
      "persistent": true
    },
    "browser_action": {
      "default_popup": "popup.html",
      "default_icon": "icon.png"
    }
  }
  